pipeline {
    agent { label 'DevopsAgentLabelV5' }
    environment{
        OPENSHIFT_API = "https://host.docker.internal:6443"
    }
    tools {
        jdk 'SystemJDK'
        nodejs 'node20'
    }
    stages {
        stage('clean workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/shaikh4git/DevSecOps-Project.git'
            }
        }
        stage("Sonarqube Analysis") {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''/opt/sonar-scanner/bin/sonar-scanner -Dsonar.projectName=Netflix \
                    -Dsonar.projectKey=Netflix'''
                }
            }
        }
        stage("Quality Gate"){
           steps {
                script {
                    waitForQualityGate abortPipeline: true, credentialsId: 'Sonar-token' 
                }
            } 
        }

        stage('TRIVY FS SCAN') {
            steps {
                sh "/home/jenkins/bin/trivy fs . "
            }
        }
        stage("Docker Build & Push"){
            environment {
                TMDB_KEY = credentials('tmdb_api_key')
            }
            steps{
                withCredentials([string(credentialsId: 'docker_cred', variable: 'DOCKER_API_KEY')]) {
                  sh '''
                       echo "$DOCKER_API_KEY" | docker login -u "shaikhdocker" --password-stdin
                       docker buildx build --build-arg TMDB_V3_API_KEY=$TMDB_KEY  -t netflix .
                       docker  tag netflix shaikhdocker/netflix:latest
                       docker  push shaikhdocker/netflix:latest
                    '''
               }
            }
        }
        stage("TRIVY"){
            steps{
                sh "/home/jenkins/bin/trivy image shaikhdocker/netflix:latest > trivyimage.txt" 
            }
        }
        stage('Deploy to Docker, Staging Environment'){
            steps{
                sh '''
                if docker ps -aq --filter "name=^netflix$" | grep -q .; then
                    echo "Removing existing container: netflix"
                    docker rm -f netflix
                fi
                docker run -d --name netflix -p 8081:80 shaikhdocker/netflix:latest
                '''
            }
        }

        stage('Deploy to my OpenShift Cluster'){
            steps{
                withCredentials([string(credentialsId: 'ocnetflix-sa-token-ID', variable: 'TOKEN')]) {
                    sh '''
                        echo "Loggin to the OpenShift using the service account token"
                        oc login $OPENSHIFT_API --token=$TOKEN --insecure-skip-tls-verify=true
                        echo "Selecting project..."
                        oc project netflix
                        
                        echo "Checking deployment..."
                        if ! oc get deployment netflix >/dev/null 2>&1; then
                            echo "Creating deployment..."
                            oc create deployment netflix --image=docker.io/shaikhdocker/netflix:latest --replicas 2
                            oc set serviceaccount deployment/netflix jenkins-sa
                            # Scale replicas
                            oc scale deployment/netflix --replicas=3
                            oc rollout status deployment/netflix
                        fi
                        
                        echo "Checking service..."
                        if ! oc get service netflix >/dev/null 2>&1; then
                            echo "Creating service..."
                            oc expose deployment netflix --port=80
                        fi
                        
                        echo "Checking route..."
                        if ! oc get route netflix >/dev/null 2>&1; then
                            echo "Creating route..."
                            oc expose service netflix
                        fi
                        
                        
                        echo ""
                        echo "========== Deployments =========="
                        oc get deployment
                        
                        echo ""
                        echo "========== Pods =========="
                        oc get pods -o wide
                        
                        echo ""
                        echo "========== Services =========="
                        oc get svc
                        
                        echo ""
                        echo "========== Routes =========="
                        oc get routes
                       '''
                }
            }
        }


        stage('Approval for Production') {

            steps {
                input message: 'Deploy this build to Production?',
                      ok: 'Approve Production Deployment'
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'k8s-kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl get nodes --kubeconfig=$KUBECONFIG
                        kubectl create namespace netflix --kubeconfig=$KUBECONFIG --dry-run=client -o yaml | kubectl apply -f - --kubeconfig=$KUBECONFIG
                        kubectl apply -f Kubernetes/deployment.yml -n netflix --kubeconfig=$KUBECONFIG
                        kubectl apply -f Kubernetes/service.yml -n netflix --kubeconfig=$KUBECONFIG
                       '''
              }
           }
        }
    }
    
post {
    always {
        emailext attachLog: true,
            subject: "${currentBuild.result}",
            body: "Project: ${env.JOB_NAME}<br/>" +
                  "Build Number: ${env.BUILD_NUMBER}<br/>" +
                  "URL: ${env.BUILD_URL}<br/>",
            to: 'shaikh4huda@gmail.com',
            attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
    }
}

}

