
pipeline {
    agent { label 'DevopsAgentLabelV5' }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_REPO = 'shaikhdocker/netflix'
        GITOPS_REPO = 'https://github.com/shaikh4git/Netflix-GitOps.git'
        GITOPS_BRANCH = 'main'
    }

    tools {
        jdk 'SystemJDK'
        nodejs 'node20'
    }

    stages {
        stage('Clean Workspaces') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Github Repositories') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/shaikh4git/DevSecOps-Project.git'

                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                    env.FULL_IMAGE = "${env.IMAGE_REPO}:${env.IMAGE_TAG}"
                }

                echo "Building ${env.FULL_IMAGE}"
            }
        }


        stage('Docker Build & Push Netflix image freshly') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'docker_cred',
                        variable: 'DOCKER_API_KEY'
                    ),
                    string(
                        credentialsId: 'tmdb_api_key',
                        variable: 'TMDB_KEY'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_API_KEY" |
                          docker login -u shaikhdocker --password-stdin

                        docker buildx build \
                          --build-arg TMDB_V3_API_KEY="$TMDB_KEY" \
                          --tag "$FULL_IMAGE" \
                          --load \
                          .

                        docker push "$FULL_IMAGE"
                    '''
                }
            }
        }
        stage('Deploy to Docker - Staging') {
            steps {
                sh '''
                    docker pull "$FULL_IMAGE"

                    if docker ps -aq \
                      --filter "name=^netflix$" | grep -q .; then
                        docker rm -f netflix
                    fi

                    docker run -d \
                      --name netflix \
                      -p 8081:80 \
                      "$FULL_IMAGE"
                '''
            }
        }
        stage('Update GitOps Repository') {
             steps {
                    withCredentials([
                        usernamePassword(
                        credentialsId: 'github-gitops-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
        
                        export GIT_TERMINAL_PROMPT=0
                        HELPER='!f() { echo "username=$GIT_USERNAME"; echo "password=$GIT_TOKEN"; }; f'
        
                        git -c credential.helper="$HELPER" clone \
                          --branch "$GITOPS_BRANCH" "$GITOPS_REPO" gitops
                        cd gitops
        
                        test -f netflix/bluegreen/bluegreen.yaml
        
                        sed -i -E "s#(image:[[:space:]]*)shaikhdocker/netflix:[^[:space:]]+#\\1${FULL_IMAGE}#" \
                          netflix/bluegreen/bluegreen.yaml
        
                        grep -q "image: ${FULL_IMAGE}" netflix/bluegreen/bluegreen.yaml \
                          || { echo "Image line was not updated"; exit 1; }
        
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@localhost"
                        git add netflix/bluegreen/bluegreen.yaml
        
                        if git diff --cached --quiet; then
                            echo "No GitOps changes required"
                        else
                            git commit -m "BlueGreen Netflix ${FULL_IMAGE}"
                            git -c credential.helper="$HELPER" push origin "HEAD:${GITOPS_BRANCH}"
                        fi
                    '''
                }
            }
        }
        
        stage('GitOps Commit Published') {
            steps {
                echo """
                Image: ${env.FULL_IMAGE}
        
                Argo CD will synchronize the Rollout manifest.
        
                Argo Rollouts will:
                  1. Start the 20% canary
                  2. Pause for manual promotion
                  3. Progress through 40%, 60%, 80%
                  4. Complete deployment at 100%
        
                Monitor:
                kubectl argo rollouts get rollout netflix -n argo-rollouts --watch
                """
            }
        }
    }

    post {
        always {
            emailext(
                attachLog: true,
                subject: "${currentBuild.currentResult}",
                body: """
                    Project: ${env.JOB_NAME}<br/>
                    Build: ${env.BUILD_NUMBER}<br/>
                    Image: ${env.FULL_IMAGE ?: 'Not built'}<br/>
                    URL: ${env.BUILD_URL}<br/>
                """,
                to: 'shaikh4huda@gmail.com',
                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
            )
        }
    }
}
